# Release signing configuration for app/build.gradle.
#
# Copy this file to keystore.properties (gitignored) in the project root and
# fill in your values. Alternatively, set the environment variables
# SHOWSONLINE_KEYSTORE_FILE, SHOWSONLINE_KEYSTORE_PASSWORD,
# SHOWSONLINE_KEY_ALIAS and SHOWSONLINE_KEY_PASSWORD (useful for CI).
# If any value is missing, release builds are produced unsigned; debug builds
# are unaffected.
#
# storeFile is resolved relative to the project root; absolute paths also work.
# Use forward slashes (C:/Users/me/keystore.jks) or escape backslashes, since
# this is a Java properties file.
storeFile=keystore/keystore.jks
storePassword=
keyAlias=
keyPassword=
